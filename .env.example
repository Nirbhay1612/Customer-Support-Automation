
# Application
APP_NAME=AI Automation System
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API
API_PREFIX=/api

# AI / LLM
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
OPENAI_API_KEY=
TEMPERATURE=0.2
MAX_TOKENS=1000

# RAG
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/vectorstore
DOCUMENTS_PATH=data/documents
FAQ_PATH=data/faq
TOP_K=5
SIMILARITY_THRESHOLD=0.5

# Database
DATABASE_URL=sqlite:///./data/automation.db

# Integrations
ORDER_API_URL=

# Email
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Webhooks
WEBHOOK_SECRET=

# Logging
LOG_LEVEL=INFO
